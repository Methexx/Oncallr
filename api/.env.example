AUTH_COOKIE_NAME=oncallr_token

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=OnCallr
